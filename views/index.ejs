<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css">
</head>

<body>

    <main>

        <h1>Family Travel Tracker</h1>

        <section class="current_user">

            <h2>Current user</h2>

            <% if (userss.length> 0) { %>
                <p>
                    <%= userss[0].name.toUpperCase() %>
                </p>
                <% } else { %>
                    <p>Add your name in family</p>
                    <% } %>

                        <form action="/add" method="post">

                            <input type="text" name="country" placeholder="Add Country" required>

                            <button type="submit">
                                Add
                            </button>

                        </form>

        </section>

        <% if (error) { %>

            <p>
                <%= error %>
            </p>

            <% } else if (message) { %>

                <p>
                    <%= message %>
                </p>

                <% } %>

                    <section class="map">

                        <object id="world_map" data="/map/world.svg" type="image/svg+xml">
                        </object>

                    </section>

                    <section class="visited_countries">

                        <h2>Visited Countries</h2>

                        <ul>

                            <% countries.forEach(country=> { %>

                                <li>
                                    <%= country.country_name %>
                                </li>

                                <% }) %>

                        </ul>

                    </section>

                    <section class="family_members">

                        <h3>Family members</h3>

                        <% users.forEach(user=> { %>

                            <div class="user-card">

                                <form action="/user" method="post">

                                    <button type="submit" style="background-color: <%= user.color %>;" name="user"
                                        value="<%= user.id %>">
                                        <%= user.name %>
                                    </button>

                                </form>

                                <form action="/delete" method="post">

                                    <button type="submit" name="user" value="<%= user.id %>">
                                        ×
                                    </button>

                                </form>

                            </div>

                            <% }) %>

                    </section>

                    <section class="add_members">

                        <h3>Add Family Member</h3>

                        <form action="/new_user" method="post">

                            <input type="text" name="new_user" placeholder="Name" required>

                            <input type="text" name="user_color" placeholder="Color" required>

                            <button type="submit">
                                ADD
                            </button>

                        </form>

                    </section>

    </main>

    <script>

        const map = document.getElementById("world_map");

        map.addEventListener("load", () => {

            const svgDocument = map.contentDocument;

            const countries = <% - JSON.stringify(countries) %>;

            countries.forEach(country => {

                const countryElement =
                    svgDocument.getElementById(country.country_code);

                if (countryElement) {

                    countryElement.style.fill = country.color;

                } else {

                    const countryElements =
                        svgDocument.querySelectorAll(
                            "." + country.country_name
                        );

                    countryElements.forEach(element => {

                        element.style.fill = country.color;

                    });

                }

            });

        });

    </script>

</body>

</html>